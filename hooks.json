{
  "comprende": {
    "SessionStart": [
      {
        "type": "command",
        "command": "out=$(node \"./dist/gate.mjs\" session-start --from-plugin) && printf '%s' \"$out\" || exit 0",
        "timeout": 30
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "out=$(node \"./dist/gate.mjs\" claude-hook --from-plugin) && printf '%s' \"$out\" || exit 0",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
