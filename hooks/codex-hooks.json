{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/gate.mjs\" session-start --from-plugin --agent codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/gate.mjs\" agent-hook --from-plugin --agent codex",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
