{
  "name": "comprende",
  "version": "0.2.0",
  "private": true,
  "description": "Claude Code plugin: explain code while building it, and an ownership gate for teams.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
