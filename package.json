{
  "name": "comprende",
  "version": "0.4.2",
  "private": true,
  "description": "Claude Code, Cursor and Codex plugin: explain code while building it, and an ownership gate for teams.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=4 test/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run build && npm test",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "^20.19.43",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "body-parser": "^2.4.0"
  }
}
